{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OpenClaw Agent",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["src/index.ts"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}",
        "VOYAGE_API_KEY": "${env:VOYAGE_API_KEY}",
        "OPENCLAW_DIR": "${env:OPENCLAW_DIR}",
        "PORT": "3000",
        "DREAM_HOUR": "3"
      },
      "console": "integratedTerminal",
      "restart": false,
      "skipFiles": ["<node_internals>/**", "node_modules/**"]
    },
    {
      "name": "OpenClaw Agent (env file)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["src/index.ts"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "restart": false,
      "skipFiles": ["<node_internals>/**", "node_modules/**"]
    }
  ]
}
